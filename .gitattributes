# Normalize text files and use LF by default
* text=auto eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
